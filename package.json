{
  "name": "swapic-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.10.0 <25"
  },
  "scripts": {
    "dev": "NEXT_PUBLIC_SWAPIC_ENV=test next dev -p 3000",
    "dev:e2e": "NEXT_PUBLIC_SWAPIC_ENV=e2e next dev -p 3100",
    "build:test": "NEXT_PUBLIC_SWAPIC_ENV=test next build",
    "build:prod": "NEXT_PUBLIC_SWAPIC_ENV=prod next build",
    "build:e2e": "NEXT_PUBLIC_SWAPIC_ENV=e2e next build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && playwright test",
    "gen:candid": "node scripts/gen-candid.mjs",
    "shots": "node scripts/shots/compare.mjs",
    "check:copy": "node scripts/check-copy.mjs",
    "check:sources": "node scripts/check-sources.mjs"
  },
  "dependencies": {
    "@icp-sdk/auth": "5.0.0",
    "@icp-sdk/canisters": "3.6.0",
    "@icp-sdk/core": "5.4.0",
    "@nfid/identitykit": "2.0.0",
    "@radix-ui/react-avatar": "1.3.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@reown/appkit": "1.8.24",
    "@reown/appkit-adapter-wagmi": "1.8.24",
    "@sentry/react": "10.78.0",
    "@tanstack/query-sync-storage-persister": "5.105.0",
    "@tanstack/react-query": "5.105.0",
    "@tanstack/react-query-persist-client": "5.105.0",
    "@wagmi/connectors": "6.2.0",
    "@wagmi/core": "2.22.1",
    "clsx": "2.1.1",
    "lucide-react": "1.64.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "tailwind-merge": "2.6.1",
    "vaul": "1.1.2",
    "viem": "2.57.10",
    "wagmi": "2.19.5",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "openapi-typescript": "7.13.0",
    "postcss": "8.5.32",
    "tailwind-scrollbar": "3.1.0",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "overrides": {
    "react": "$react",
    "react-dom": "$react-dom",
    "@wagmi/connectors": "$@wagmi/connectors"
  }
}
